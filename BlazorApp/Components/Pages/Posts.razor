@page "/posts"
@using ApiContracts.DTO.Post
@using BlazorApp.Services
@inject IPostService PostService
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Post Overview</PageTitle>
<h3>Posts</h3>


<div class="mb-3">
    <input @bind="searchTitle" placeholder="Search  by title" class="form-control d-inline-block w-auto"/>
    <input @bind="filterUserId" type="number" placeholder="Filter by User ID" class="form-control d-inline-block w-auto"/>
    <button @onclick="SearchPost">Search</button>
    <button @onclick="() => { searchTitle=string.Empty; filterUserId=null;}">Clear</button>
</div>
<button @onclick="NavigateToCreate" type="button" class="btn btn-success">Create new post</button>
@if (isLoading)
{
    <div class="spinner"></div>
}else if (posts == null || !posts.Any() )
{
    <h1>Error loading posts :( list is empty</h1>
}
else
{
    <div class="row">
        @foreach (var post in posts)
        {
            <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h3 class="card-title">
                                Title: @post.Title
                            </h3>
                            <p class="card-text">
                                @post.Body
                            </p>
                            <p class="text-muted">
                                User ID: @post.UserId
                            </p>
                            <div>
                                <button @onclick="() => ViewPost(post.Id)" type="button"  class="btn btn-sm btn-info">View</button>
                                <button @onclick="() => EditPost(post.Id)" type="button"  class="btn btn-sm btn-primary">Edit</button>
                                <button @onclick="() => DeletePost(post.Id)" type = "button" class="btn btn-sm btn-danger">Delete</button>
                                <button @onclick="() => ViewComments(post.Id)" type="button"  class="btn btn-sm btn-secondary">Comments</button>
                            </div>
                        </div>
                    </div>
            </div>
            
        }
    </div>
}

@code {
    private List<PostDto> posts = new();
    private bool isLoading = true;
    private bool isFirstLoad = true;
    private string searchTitle = string.Empty;
    private int? filterUserId;

    protected override async Task OnInitializedAsync()
    {
        await LoadPosts();
    }
    private async Task LoadPosts()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            if (isFirstLoad)
            {
                await Task.Delay(1500);
                isFirstLoad = false;
            }
            var getallposts = await PostService.GetAllPostsAsync(string.IsNullOrWhiteSpace(searchTitle)? null : searchTitle, filterUserId);
            posts = getallposts ?? new List<PostDto>();
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error loading posts :( {e.Message}");
            posts = new List<PostDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
       
        

    }
    private async Task SearchPost()
    {
        await LoadPosts();
    }
    
    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/posts/create");
    }
    private void ViewPost(int id)
    {
        Navigation.NavigateTo($"/posts/{id}");
    }

    private void EditPost(int id)
    {
        Navigation.NavigateTo($"/posts/edit/{id}");
    }
    private async Task DeletePost(int id)
    {
        try
        {
            await PostService.DeletePostAsync(id);
            await LoadPosts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting post: {ex.Message}");
        }
    }
    private void ViewComments(int postId)
    {
        Navigation.NavigateTo($"/posts/{postId}/comments");
    }

}