@page "/users"
@using ApiContracts
@using BlazorApp.Services
@inject IUserService _userService

<PageTitle>Users</PageTitle>

<div>
    <div class="adding-new-user">
        <h1>Add new user</h1>
        <input placeholder="username" @bind="_newUsername" />
        <input placeholder="password" @bind="_newPassword" />
        <button @onclick="AddNewUser">Add user</button>
    </div>

    <hr/>
    <div class="listing-users">
        <h1>List of users</h1>
        <ul>
            @foreach (var user in users)
            {
                <li>
                    <strong>User id:</strong> @user.Id,
                    <strong> Username:</strong> @user.Username
                </li>
            }
        </ul>
    </div>

    <hr>
    <!-- Delete by ID -->
    <h3>Delete user by ID</h3>
    <input placeholder="User ID" @bind="_idToDelete" />
    <button @onclick="() => DeleteUser(_idToDelete)">Delete user</button>
</div>
@code {
    
    // for displaying users
    private List<UserDTO> users = new List<UserDTO>();
    
    // for adding users
    private string? _newUsername;
    private string? _newPassword;
    private int _idToDelete;
    
    protected override async Task OnInitializedAsync()
    {
        users = await _userService.GetMany();
    }

    public async Task AddNewUser()
    {
        CreateUserDTO createUserDto = new CreateUserDTO()
        {
            Username = _newUsername,
            Password = _newPassword
        };
        // adding new user through HTTP
        var newUser = await _userService.AddUser(createUserDto);
        
        // adding user to the local list
        users.Add(newUser);
        
        // clear input fields
        _newUsername = String.Empty;
        _newPassword = String.Empty;
    }
    
    private async Task DeleteUser(int id)
    {
        if (id <= 0) return;
        await _userService.DeleteUser(id);

        // Update UI by removing deleted user
        users.RemoveAll(u => u.Id == id);
    }

}