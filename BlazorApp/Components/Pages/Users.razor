@page "/users"
@using BlazorApp.Services
@using ApiContracts.DTO.User
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Users</PageTitle>

<h3>Users in WEBAPI:</h3>

<div class="mb-3">
    <input @bind="searchByUsername" 
           placeholder="Search by username" class="form-control" />
    <button @onclick="SearchUsers" class="btn btn-primary mt-2">Search</button>
    <button @onclick="ClearUser" class ="btn btn-primary mt-2">Clear</button>
    </div>
<button type="button" @onclick="NavigateToCreate"  class="btn btn-success mb-3">Create New User</button>

@if (isLoading)
{
    <div class="spinner"></div>
}
else if (users == null || !users.Any())
{
    <p>No users found.</p>
    <div class="alert alert-danger"> @allertToShow
    </div>
}
else
{
    <table class="table">
        <thead>
        <tr> <th>ID</th>
       <th>Username</th>
        <th>Password</th>
        <th>ActionToDo</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in users)
    {
        <tr>
            
            <td>
                @user.Id
            </td>
            <td>
                @user.Username
            </td>
            <td>
                @user.Password
            </td>
            <td>
                <button class="btn btn-sm btn-primary" @onclick="() => EditUser(user.Id)">Edit</button>
                <button class="btn btn-sm btn-primary" @onclick="() => DeleteUser(user.Id)">Delete</button>
            </td>
        </tr>
    }
    </tbody>
        
    </table>
}

@code{

    private List<UserDto> users = new List<UserDto>();
    private string searchByUsername = string.Empty;
    private bool isLoading = true;
    private string allertToShow =  string.Empty;
    private bool isFirstLoad = true;
    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {

        isLoading = true;
        allertToShow = string.Empty;
        StateHasChanged();
        try
        {
            if (isFirstLoad)
            {
                await Task.Delay(1500);
                isFirstLoad = false;
            }
            var loadedusers = await UserService.GetAllUsersAsync(string.IsNullOrWhiteSpace(searchByUsername) ? null : searchByUsername);
            users = loadedusers ?? new List<UserDto>(); 
        }
        catch (Exception ex)
        {
            allertToShow = "Error loading users";
            Console.WriteLine($"Error: {ex.Message}");
            users = new List<UserDto>();
            
        }
        finally
        {
            
           //System.Threading.Thread.Sleep(1000);
            isLoading = false;
            StateHasChanged();
        }
    }
    private async Task SearchUsers()
    {
        await LoadUsers();
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/users/create");
    }
    
    private async Task DeleteUser(int id)
    {
        
            try
            {
                await UserService.DeleteUserAsync(id);
                await LoadUsers();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting user: {ex.Message}");
            }
            
    }
    private void EditUser(int id)
    {
        Navigation.NavigateTo($"/users/edit/{id}");
    }


    private async Task ClearUser()
    {
        searchByUsername=String.Empty;
        await LoadUsers();
    }

}