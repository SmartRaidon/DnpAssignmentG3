@page "/"

<PageTitle>Home</PageTitle>

<div class="site-wrapper">
  <section class="page-home pt-table desktop-768">
    <div class="overlay"></div>
    <div class="pt-tablecell relative">
      <div class="container">
        <div class="row">
          <div class="col-lg-8 col-lg-offset-2 text-center">
            <div class="page-title">
              <h2 class="heading-page">Welcome</h2>
              <p class="text-primary">
              TO MY SIMPLE FORUM
              </p>
              <span class="title-bg">HOME</span>
            </div>
          </div>
        </div>

        <div class="row no-gutter">
          
          <div class="hex-grid">
            <div class="hexagon-item">
              <div class="hex-item"><div></div><div></div><div></div></div>
              <div class="hex-item"><div></div><div></div><div></div></div>
              <a class="hex-content" href="/users">
                <span class="hex-content-inner">
                  <span class="icon"><i class="bi bi-people"></i></span>
                  <span class="title">Users</span>
                </span>
                <svg viewBox="0 0 173.20508075688772 200" height="200" width="174">
                  <path d="M86.60 0L173.21 50v100l-86.60 50L0 150V50z" fill="transparent" />
                </svg>
              </a>
            </div>

            <div class="hexagon-item">
              <div class="hex-item"><div></div><div></div><div></div></div>
              <div class="hex-item"><div></div><div></div><div></div></div>
              <a class="hex-content" href="/posts">
                <span class="hex-content-inner">
                  <span class="icon"><i class="bi bi-card-text"></i></span>
                  <span class="title">Posts</span>
                </span>
                <svg viewBox="0 0 173.20508075688772 200" height="200" width="174">
                  <path d="M86.60 0L173.21 50v100l-86.60 50L0 150V50z" fill="transparent" />
                </svg>
              </a>
            </div>

         
          </div>
        </div>
      </div>
    </div>
  </section>
</div>