@page "/users/create"
@using ApiContracts.DTO.User
@using BlazorApp.Services
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Create user</PageTitle>
<h3 class="text-center text-primary">Create USER:</h3>

<EditForm Model="@user" OnValidSubmit="CreateUser">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label text-primary">Username: </label>
        <InputText @bind-Value="user.Username"  placeholder="username to create" class="form-control" />
        <ValidationMessage For="@(() => user.Username)" />
    </div>
    <div class="mb-3">
        <label class="form-label text-primary">Password: </label>
        <InputText type="password" @bind-Value="user.Password"   placeholder="password (required)" class="form-control" />
        <ValidationMessage For="@(() => user.Password)" />
    </div>
    <div class="mb-3">
        @if (IsFormValid)
        {
            <button type="submit" class="btn btn-primary">Create User!</button>
        }
        <button type="button" class="btn btn-secondary" @onclick="Back">Go back</button>
    </div>
</EditForm>

@if (!IsFormValid)
{
    <div class="alert alert-warning">
        @if (user.Username.Trim().Length < 3)
        {
            <p>Username must be at least 3 characters</p>
        }
        @if (string.IsNullOrWhiteSpace(user.Password))
        {
            <p>Password is required</p>
        }
        else if (user.Password.Length < 2)
        {
            <p>Password must be at least 2 characters</p>
        }
    </div>
}

@code {
    private UserCreateDto user = new() { Username = string.Empty, Password = string.Empty };
    
    private bool IsFormValid => 
        user.Username.Trim().Length >= 3 && 
        !string.IsNullOrWhiteSpace(user.Password) && 
        user.Password.Length >= 2;
    
    private async Task CreateUser()
    {
        if (!IsFormValid)
        {
            return;
        }
        
        try
        {
            await UserService.AddUserAsync(user);
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
           Console.Write(ex.Message);
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/");
    }
}