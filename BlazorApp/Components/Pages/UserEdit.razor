@page "/users/edit/{UserId:int}"
@attribute [Authorize]
@using System.Security.Claims
@using ApiContracts.DTO.User
@using BlazorApp.Services
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Edit user</PageTitle>

@if (isLoading)
{
    <p>Loading user...</p>
}
else if (!canEdit)
{
    <div class="alert alert-danger">
        This is not the account you are currently logged in with, so you cannot edit its credentials.
    </div>
    <p  class="text-primary"> you are trying to edit user with id: @existingUser.Id</p>
    <p class="text-primary">but you are user with id: @currentloggedinuser </p>
    <button class="btn btn-secondary" @onclick="Back">Go back</button>
}
else if (existingUser == null)
{
    <h3>User not found</h3>
    <button class="btn btn-secondary" @onclick="Back">Go back</button>
}
else if (updateDto == null)
{
    <p>Initializing form...</p>
}
else
{
    <h3 class="text-center text-primary">Edit your account</h3>

    <EditForm Model="@updateDto" OnValidSubmit="UpdateUser">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label text-primary">Username:</label>
            <InputText @bind-Value="updateDto.Username" placeholder="Username" class="form-control" />
            <ValidationMessage For="@(() => updateDto.Username)" />
        </div>

        <div class="mb-3">
            <label class="form-label text-primary">New password (leave empty to keep current):</label>
            <InputText type="password" @bind-Value="passwordInput" placeholder="put your new password" class="form-control" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <button disabled="@(!IsUsernameValid)" type="submit" class="btn btn-primary">Update</button>
            <button type="button" class="btn btn-secondary" @onclick="Back">Go back</button>
        </div>
    </EditForm>

    @if (!IsUsernameValid)
    {
        <div class="alert alert-warning">
            Username must have at least 3 characters.
        </div>
    }
}

@code {
    [Parameter] public int UserId { get; set; }
    [CascadingParameter] public Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private UserDto? existingUser;
    private UserUpdateDto? updateDto;
    private string passwordInput = string.Empty;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private bool canEdit;
    private int? currentloggedinuser;
    private bool IsUsernameValid => updateDto != null && updateDto.Username.Trim().Length >= 3;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask == null)
        {
            errorMessage = "Authentication state not available.";
            isLoading = false;
            return;
        }

        AuthenticationState authState = await AuthenticationStateTask;
        ClaimsPrincipal? claimsPrincipal = authState?.User;
        
        if (claimsPrincipal == null)
        {
            errorMessage = "User not authenticated.";
            isLoading = false;
            return;
        }
        try
        {
            
            string? userName = claimsPrincipal.Identity?.Name;
            IEnumerable<Claim> claims = claimsPrincipal.Claims;
            string userIdAsString = claims.Single(c => c.Type == "Id").Value;
            currentloggedinuser = int.Parse(userIdAsString);

            existingUser = await UserService.GetUserByIdAsync(UserId);
            canEdit = existingUser != null && currentloggedinuser.HasValue && existingUser.Id == currentloggedinuser.Value;

            if (existingUser != null && canEdit)
            {
                updateDto = new UserUpdateDto
                {
                    Username = existingUser.Username,
                    Password = null
                };
                passwordInput = string.Empty;
            }
            else
            {
                updateDto = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading user: {ex.Message}";
            updateDto = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateUser()
    {
        if (!canEdit || updateDto == null)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            
            updateDto.Password = string.IsNullOrWhiteSpace(passwordInput) ? null : passwordInput;
            
            await UserService.UpdateUserAsync(UserId, updateDto);
            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating user: {ex.Message}";
        }
    }

    private void Back() => Navigation.NavigateTo("/users");

   
}